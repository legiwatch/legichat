# ─── LegiChat — variables d'environnement ────────────────────────────────────
# Copier ce fichier en .env.local et remplir les valeurs.
# NE PAS committer .env.local (il est dans .gitignore).

# Mode d'exécution : "mock" (développement) ou "mcp" (MCP réel)
MCP_MODE=mock

# URL de base du serveur MCP (sans /mcp)
MCP_BASE_URL=http://localhost:1791

# Token d'accès au MCP — JAMAIS préfixé NEXT_PUBLIC_ — serveur uniquement
MCP_TOKEN=

# Délai simulé en mode mock (ms). Défaut : 1500. Monter à 40000 pour tester
# l'indicateur d'étapes en conditions réelles.
MOCK_DELAY_MS=1500
